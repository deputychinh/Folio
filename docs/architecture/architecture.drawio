<mxfile host="gen_diagrams.py" type="device"><diagram id="Folio — system architecture" name="Folio — system architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2060" pageHeight="1050" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="col-clients" value="Clients" style="swimlane;horizontal=1;startSize=56;html=1;whiteSpace=wrap;collapsible=0;rounded=1;arcSize=2;fillColor=#FAF8F3;swimlaneFillColor=#FAF8F3;strokeColor=#E4DFD4;fontSize=24;fontStyle=1;fontColor=#1B2733;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="330" height="900" as="geometry"/></mxCell><mxCell id="col-vercel" value="Vercel (sin1)" style="swimlane;horizontal=1;startSize=56;html=1;whiteSpace=wrap;collapsible=0;rounded=1;arcSize=2;fillColor=#E3EEF0;swimlaneFillColor=#E3EEF0;strokeColor=#E4DFD4;fontSize=24;fontStyle=1;fontColor=#1B2733;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="390" y="20" width="640" height="900" as="geometry"/></mxCell><mxCell id="col-supabase" value="Supabase (ap-southeast-1)" style="swimlane;horizontal=1;startSize=56;html=1;whiteSpace=wrap;collapsible=0;rounded=1;arcSize=2;fillColor=#F6E7DC;swimlaneFillColor=#F6E7DC;strokeColor=#E4DFD4;fontSize=24;fontStyle=1;fontColor=#1B2733;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1070" y="20" width="560" height="900" as="geometry"/></mxCell><mxCell id="col-delivery" value="Delivery" style="swimlane;horizontal=1;startSize=56;html=1;whiteSpace=wrap;collapsible=0;rounded=1;arcSize=2;fillColor=#FAF8F3;swimlaneFillColor=#FAF8F3;strokeColor=#E4DFD4;fontSize=24;fontStyle=1;fontColor=#1B2733;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1670" y="20" width="370" height="900" as="geometry"/></mxCell><mxCell id="member" value='&lt;b&gt;Team member&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:15px;color:#5B6670"&gt;browser · vanilla JS SPA&lt;br&gt;auth-js session&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#1F4E5A;strokeWidth=1.5;fontColor=#1B2733;fontSize=20;spacing=8;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="140" width="270" height="120" as="geometry"/></mxCell><mxCell id="client" value='&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:15px;color:#5B6670"&gt;browser · no account&lt;br&gt;opens /q/:token&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#B4561F;strokeWidth=1.5;fontColor=#1B2733;fontSize=20;spacing=8;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="560" width="270" height="120" as="geometry"/></mxCell><mxCell id="cdn" value='&lt;b&gt;Edge network + static files&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:15px;color:#5B6670"&gt;index.html, hashed JS/CSS, fonts&lt;br&gt;CSP · HSTS · SPA fallback&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#1F4E5A;strokeWidth=1.5;fontColor=#1B2733;fontSize=20;spacing=8;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="430" y="120" width="560" height="120" as="geometry"/></mxCell><mxCell id="fn" value='&lt;b&gt;Serverless function api/index.js&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:15px;color:#5B6670"&gt;NestJS app, built once per instance&lt;br&gt;/api/v1/* · Node 22 · 1 GB · 10 s&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#1F4E5A;strokeWidth=1.5;fontColor=#1B2733;fontSize=20;spacing=8;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="430" y="380" width="560" height="130" as="geometry"/></mxCell><mxCell id="fn-modules" value='&lt;b&gt;Modules&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:15px;color:#5B6670"&gt;me · workspaces · members · customers&lt;br&gt;catalog · quotes · public-quotes · dashboard&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FAF8F3;strokeColor=#E4DFD4;strokeWidth=1.5;fontColor=#1B2733;fontSize=20;spacing=8;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="430" y="560" width="560" height="110" as="geometry"/></mxCell><mxCell id="fn-layers" value='&lt;b&gt;Inside each request&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:15px;color:#5B6670"&gt;AuthGuard → WorkspaceGuard → DTO validation&lt;br&gt;controller → service → repository&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FAF8F3;strokeColor=#E4DFD4;strokeWidth=1.5;fontColor=#1B2733;fontSize=20;spacing=8;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="430" y="710" width="560" height="110" as="geometry"/></mxCell><mxCell id="auth" value='&lt;b&gt;Auth (GoTrue)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:15px;color:#5B6670"&gt;email + password, magic link&lt;br&gt;JWT signed ES256 · JWKS&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#B4561F;strokeWidth=1.5;fontColor=#1B2733;fontSize=20;spacing=8;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1110" y="120" width="480" height="120" as="geometry"/></mxCell><mxCell id="pg" value='&lt;b&gt;Postgres 17&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:15px;color:#5B6670"&gt;RLS on every table · is_member()&lt;br&gt;atomic functions: save_quote, send_quote,&lt;br&gt;respond_public_quote, accept_invite …&lt;br&gt;quotes_view (effective status)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#B4561F;strokeWidth=1.5;fontColor=#1B2733;fontSize=20;spacing=8;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1110" y="380" width="480" height="190" as="geometry"/></mxCell><mxCell id="storage" value='&lt;b&gt;Storage&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:15px;color:#5B6670"&gt;workspace logos (next step)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FAF8F3;strokeColor=#E4DFD4;strokeWidth=1.5;fontColor=#1B2733;fontSize=20;spacing=8;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1110" y="640" width="480" height="90" as="geometry"/></mxCell><mxCell id="gh" value='&lt;b&gt;GitHub repository&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:15px;color:#5B6670"&gt;monorepo: apps/web · apps/api&lt;br&gt;packages/shared · supabase/&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#1B2733;strokeWidth=1.5;fontColor=#1B2733;fontSize=20;spacing=8;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1700" y="120" width="310" height="120" as="geometry"/></mxCell><mxCell id="ci" value='&lt;b&gt;GitHub Actions · CI&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:15px;color:#5B6670"&gt;lint (BEM) · typecheck · unit&lt;br&gt;integration on local Supabase&lt;br&gt;bundle gate · Playwright E2E&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#1B2733;strokeWidth=1.5;fontColor=#1B2733;fontSize=20;spacing=8;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1700" y="330" width="310" height="150" as="geometry"/></mxCell><mxCell id="migrate" value='&lt;b&gt;GitHub Actions · Migrate&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:15px;color:#5B6670"&gt;supabase db push&lt;br&gt;staging on merge · prod on approval&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#1B2733;strokeWidth=1.5;fontColor=#1B2733;fontSize=20;spacing=8;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1700" y="560" width="310" height="120" as="geometry"/></mxCell><mxCell id="e1" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#1B2733;strokeWidth=1.5;fontSize=16;fontColor=#1B2733;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" edge="1" parent="1" source="member" target="cdn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#1B2733;strokeWidth=1.5;fontSize=16;fontColor=#1B2733;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="member" target="auth"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="185" y="90"/><mxPoint x="1350" y="90"/></Array></mxGeometry></mxCell><mxCell id="e3" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#1B2733;strokeWidth=1.5;fontSize=16;fontColor=#1B2733;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.75;entryX=0;entryY=0.25;" edge="1" parent="1" source="member" target="fn"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="365" y="230"/><mxPoint x="365" y="410"/></Array></mxGeometry></mxCell><mxCell id="e4" value="4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#1B2733;strokeWidth=1.5;fontSize=16;fontColor=#1B2733;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.2;entryX=0;entryY=0.8;" edge="1" parent="1" source="fn" target="auth"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#1B2733;strokeWidth=1.5;fontSize=16;fontColor=#1B2733;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.55;entryX=0;entryY=0.45;" edge="1" parent="1" source="fn" target="pg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#1B2733;strokeWidth=1.5;fontSize=16;fontColor=#1B2733;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.17;entryX=0;entryY=0.8;" edge="1" parent="1" source="client" target="cdn"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="580"/><mxPoint x="400" y="215"/></Array></mxGeometry></mxCell><mxCell id="e7" value="7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#1B2733;strokeWidth=1.5;fontSize=16;fontColor=#1B2733;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.75;entryX=0;entryY=0.75;" edge="1" parent="1" source="client" target="fn"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="382" y="650"/><mxPoint x="382" y="480"/></Array></mxGeometry></mxCell><mxCell id="e8" value="8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#1B2733;strokeWidth=1.5;fontSize=16;fontColor=#1B2733;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;strokeColor=#5B6670;exitX=1;exitY=0.9;entryX=0;entryY=0.85;" edge="1" parent="1" source="fn" target="pg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#1B2733;strokeWidth=1.5;fontSize=16;fontColor=#1B2733;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;strokeColor=#5B6670;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="gh" target="cdn"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1855" y="70"/><mxPoint x="710" y="70"/></Array></mxGeometry></mxCell><mxCell id="e10" value="on every PR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#1B2733;strokeWidth=1.5;fontSize=16;fontColor=#1B2733;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;strokeColor=#5B6670;" edge="1" parent="1" source="gh" target="ci"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#1B2733;strokeWidth=1.5;fontSize=16;fontColor=#1B2733;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;strokeColor=#5B6670;exitX=0;exitY=0.5;entryX=1;entryY=0.6;" edge="1" parent="1" source="migrate" target="pg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flows" value="&lt;b&gt;1&lt;/b&gt; GET the SPA (static, CDN) &amp;nbsp; &lt;b&gt;2&lt;/b&gt; sign in / refresh token (auth-js) &amp;nbsp; &lt;b&gt;3&lt;/b&gt; /api/v1/* with Bearer JWT + x-workspace-id &amp;nbsp; &lt;b&gt;4&lt;/b&gt; verify JWT via JWKS (cached) &amp;nbsp; &lt;b&gt;5&lt;/b&gt; PostgREST + RPC as the user, so RLS applies&lt;br&gt;&lt;b&gt;6&lt;/b&gt; client opens /q/:token &amp;nbsp; &lt;b&gt;7&lt;/b&gt; /api/v1/public/quotes/:token (rate-limited) &amp;nbsp; &lt;b&gt;8&lt;/b&gt; service role, only 3 locked functions &amp;nbsp; &lt;b&gt;9&lt;/b&gt; Vercel Git: preview per PR, main → production &amp;nbsp; &lt;b&gt;10&lt;/b&gt; migrations via supabase db push" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#1B2733;fontFamily=Helvetica;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="935" width="2020" height="60" as="geometry"/></mxCell><mxCell id="legend" value="Solid = request path · dashed = privileged or delivery path. The browser talks to Supabase only for Auth; all data goes through the API." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#5B6670;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="1000" width="1500" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
