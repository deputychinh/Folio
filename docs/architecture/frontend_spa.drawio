<mxfile host="gen_diagrams.py" type="device"><diagram id="Folio — single-page app (vanilla JS)" name="Folio — single-page app (vanilla JS)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1000" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="main" value='&lt;b&gt;main.js&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:15px;color:#5B6670"&gt;styles (layer order first) · route table&lt;br&gt;toast region · auth events&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FAF8F3;strokeColor=#1B2733;strokeWidth=1.5;fontColor=#1B2733;fontSize=20;spacing=8;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="380" height="110" as="geometry"/></mxCell><mxCell id="router" value='&lt;b&gt;core/router.js&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:15px;color:#5B6670"&gt;History API · :params · query&lt;br&gt;guards → layout → page&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#1F4E5A;strokeWidth=1.5;fontColor=#1B2733;fontSize=20;spacing=8;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="380" height="110" as="geometry"/></mxCell><mxCell id="guards" value='&lt;b&gt;core/guards.js&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:15px;color:#5B6670"&gt;requireAuth · requireWorkspace&lt;br&gt;guestOnly · safe ?next=&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#1F4E5A;strokeWidth=1.5;fontColor=#1B2733;fontSize=20;spacing=8;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="380" height="100" as="geometry"/></mxCell><mxCell id="layout" value='&lt;b&gt;Layouts&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:15px;color:#5B6670"&gt;AppShell (sidebar, workspace switcher