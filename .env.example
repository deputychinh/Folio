# Copy to .env. Local values come from `npx supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Server only. Never prefix with VITE_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:5180
PORT=3001

# Read by Vite for the SPA (public values only).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
